{
  "crons": [
    {
      "path": "/api/mandi-sync",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/proxy/:path*",
      "destination": "/api/proxy"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap?type=index"
    },
    {
      "source": "/sitemap-static.xml",
      "destination": "/api/sitemap?type=static"
    },
    {
      "source": "/sitemap-:city.xml",
      "destination": "/api/sitemap?type=city&city=:city"
    },
    {
      "source": "/api/sitemap-:city.xml",
      "destination": "/api/sitemap?type=city&city=:city"
    },
    {
      "source": "/:key([a-zA-Z0-9]{32}).txt",
      "destination": "/api/indexnow-key?key=:key"
    },
    {
      "source": "/product-images/:slug.png",
      "destination": "/api/image?slug=:slug"
    },
    {
      "source": "/api/upload-image",
      "destination": "/api/image"
    },
    {
      "source": "/api/resolve-link",
      "destination": "/api/geocode?type=resolve-link"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?homepage=true"
    },
    {
      "source": "/category/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?category=:slug"
    },
    {
      "source": "/:city/category/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?city=:city&category=:slug"
    },
    {
      "source": "/:city([a-zA-Z0-9_-]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?city=:city"
    },
    {
      "source": "/product/:category/:product",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?city=product&product=:product"
    },
    {
      "source": "/:city/:category/:product",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?city=:city&product=:product"
    },
    {
      "source": "/:city/:product",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?city=:city&product=:product"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
