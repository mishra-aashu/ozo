{
  "crons": [
    {
      "path": "/api/mandi-sync",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(sitemap.*\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=43200"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(sw\\.js|firebase-messaging-sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/proxy/:path*",
      "destination": "/api/proxy"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap?type=index"
    },
    {
      "source": "/sitemap-static.xml",
      "destination": "/api/sitemap?type=static"
    },
    {
      "source": "/sitemap-categories.xml",
      "destination": "/api/sitemap?type=categories"
    },
    {
      "source": "/sitemap-:city([a-zA-Z0-9_-]+)-:chunk([0-9]+).xml",
      "destination": "/api/sitemap?type=city&city=:city&chunk=:chunk"
    },
    {
      "source": "/sitemap-:city([a-zA-Z0-9_-]+).xml",
      "destination": "/api/sitemap?type=city&city=:city"
    },
    {
      "source": "/:key([a-zA-Z0-9]{32}).txt",
      "destination": "/api/indexnow-key?key=:key"
    },
    {
      "source": "/product-images/:slug.png",
      "destination": "/api/image?slug=:slug"
    },
    {
      "source": "/api/upload-image",
      "destination": "/api/image"
    },
    {
      "source": "/api/resolve-link",
      "destination": "/api/geocode?type=resolve-link"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?homepage=true"
    },
    {
      "source": "/category/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?category=:slug"
    },
    {
      "source": "/:city/category/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?city=:city&category=:slug"
    },
    {
      "source": "/product/:category/:product",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?category=:category&product=:product"
    },
    {
      "source": "/:city/:category/:product",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?city=:city&category=:category&product=:product"
    },
    {
      "source": "/:city/:product",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?city=:city&product=:product"
    },
    {
      "source": "/:city([a-zA-Z0-9_-]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[cC]rawl|[sS]pider|[gG]oogle|[bB]ing|[yY]andex|[bB]aidu|[dD]uck[dD]uck|[sS]lurp|[pP]interest|[fF]acebook|[tT]witter|[lL]inked[iI]n|[wW]hats[aA]pp|[tT]elegram).*"
        }
      ],
      "destination": "/api/render-seo?city=:city"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
