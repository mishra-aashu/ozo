# =========================================================================
# OZO Hyper-Local Quick Commerce Platform — Environment Configurations Example
# Copy this file to '.env' and populate it with valid keys.
# DO NOT commit '.env' to the repository!
# =========================================================================

# -------------------------------------------------------------------------
# 1. Supabase Core Integration (Vite Frontend & Serverless Functions)
# -------------------------------------------------------------------------
# Public Supabase Project Endpoint API URL (client-safe)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# Public Supabase Anon/Publishable Key (client-safe)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct Connection URL (Bypasses proxies, crucial for Realtime WebSockets)
VITE_SUPABASE_DIRECT_URL=https://your-supabase-project.supabase.co

# -------------------------------------------------------------------------
# 2. Third-Party CDN Credentials
# -------------------------------------------------------------------------
# ImageKit Endpoint URL (client-safe)
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-project-id/

# ImageKit Public Key (client-safe)
VITE_IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key

# ImgBB API Key (used as a fallback CDN)
VITE_IMGBB_API_KEY=your-imgbb-api-key
VITE_FREEIMAGE_API_KEY=your-freeimage-api-key

# -------------------------------------------------------------------------
# 3. Payments Gateway Configurations (Razorpay & Cashfree)
# -------------------------------------------------------------------------
# Razorpay Key ID (client-safe)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# Cashfree Environment Mode ('sandbox' or 'production')
VITE_CASHFREE_ENV=sandbox

# -------------------------------------------------------------------------
# 4. Search Engine Crawler & Scraping (Local Image Tool)
# -------------------------------------------------------------------------
# Self-hosted/Remote OpenSERP API Endpoint (duckduckgo/bing/google query proxy)
OPENSERP_URL=http://localhost:7000

# -------------------------------------------------------------------------
# 5. Server-Side Secret keys (Vercel Serverless / Supabase Edge Functions)
# -------------------------------------------------------------------------
# NOTE: These should be configured in Vercel Dashboard / Supabase Vault instead of .env
IMAGEKIT_PRIVATE_KEY=private_your-imagekit-private-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose

# Razorpay Webhook Signatures
RAZORPAY_KEY_SECRET=your-razorpay-secret-key

# Cashfree API Credentials
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
